# {{ display_name }} popups: same glass as the quiet cards (surface at
# pill_alpha), border keeps the stock echo of the window-border gradient.
# Covers every bar flyout: dropdowns, OSD, popup cards, detail panels.
background       = "{{ surface }}"
background-alpha = {{ pill_alpha }}
text             = "{{ foreground }}"
border           = "hyprland.active-border"
border-alpha     = 1.0
