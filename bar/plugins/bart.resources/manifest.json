{
  "schemaVersion": 1,
  "id": "bart.resources",
  "name": "Resources",
  "version": "1.0.0",
  "author": "bart",
  "description": "CPU / RAM / temp / disk cluster with a detail panel",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "BarWidget.qml" },
  "barWidget": {
    "displayName": "Resources",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "intervalSec": 2 },
    "schema": [
      { "key": "intervalSec", "type": "integer", "label": "Poll interval (s)", "min": 1, "max": 60 }
    ]
  }
}
