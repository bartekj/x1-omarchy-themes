#!/usr/bin/env bash
# CPU package temperature for the quattro bar. hwmon indices are not
# boot-stable, so resolve coretemp by name; fall back to the x86_pkg_temp
# thermal zone. >90 degC renders in the theme urgent color ("active" is the
# only class the bar's command-module engine supports).
set -u
export LC_ALL=C

t=""
for h in /sys/class/hwmon/hwmon*; do
  [[ -r $h/name && $(<"$h/name") == coretemp && -r $h/temp1_input ]] && { t=$(<"$h/temp1_input"); break; }
done
if [[ -z $t ]]; then
  for z in /sys/class/thermal/thermal_zone*; do
    [[ -r $z/type && $(<"$z/type") == x86_pkg_temp ]] && { t=$(<"$z/temp"); break; }
  done
fi
[[ -n $t ]] || { printf '{"text":" --°"}\n'; exit 0; }

c=$(((t + 500) / 1000))
k=""
((c > 90)) && k="active"
printf '{"text":" %2d°","tooltip":"CPU package %d°C\\nClick: btop","class":"%s"}\n' "$c" "$c" "$k"
