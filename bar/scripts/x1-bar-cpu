#!/usr/bin/env bash
# CPU % for the quattro bar. State file keeps the previous /proc/stat sample
# because the shell re-execs this script fresh on every interval tick.
set -u
export LC_ALL=C

state="${XDG_RUNTIME_DIR:-/tmp}/x1-bar-cpu.prev"
read -r _ user nice system idle iowait irq softirq steal _ </proc/stat
total=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle_all=$((idle + iowait))
pt=0 pi=0
[[ -r $state ]] && read -r pt pi <"$state"
printf '%s %s\n' "$total" "$idle_all" >"$state"

dt=$((total - pt)) di=$((idle_all - pi))
pct=0
((dt > 0)) && pct=$(((100 * (dt - di) + dt / 2) / dt))
((pct > 100)) && pct=100
((pct < 0)) && pct=0

printf '{"text":" %3d%%","tooltip":"CPU %d%%\\nClick: btop"}\n' "$pct" "$pct"
