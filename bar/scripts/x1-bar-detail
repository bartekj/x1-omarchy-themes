#!/usr/bin/env bash
# Per-resource detail data for the bart.resources panels.
# Usage: x1-bar-detail <cpu|mem|temp|disk>
#
# Only runs while a panel is open (1s tick), so the bar's own x1-bar-stats
# stays lean. Each section prints a single JSON line.
set -u
export LC_ALL=C

section="${1:-cpu}"
state_dir="${XDG_RUNTIME_DIR:-/tmp}"

# Percent-encode-free JSON string escaping for process names.
jstr() {
  local s=${1//\\/\\\\}
  s=${s//\"/\\\"}
  printf '%s' "$s"
}

detail_cpu() {
  local state="$state_dir/x1-bar-detail-cores.prev"
  local -a cores=() out=()
  local line cpu tot idle_all prev_tot prev_idle pct i

  # Per-thread deltas against the previous sample.
  declare -A prev=()
  if [[ -r $state ]]; then
    while read -r cpu tot idle_all; do prev[$cpu]="$tot $idle_all"; done <"$state"
  fi

  : >"$state.tmp"
  while read -r cpu user nice system idle iowait irq softirq steal _; do
    [[ $cpu == cpu[0-9]* ]] || continue
    tot=$((user + nice + system + idle + iowait + irq + softirq + steal))
    idle_all=$((idle + iowait))
    printf '%s %s %s\n' "$cpu" "$tot" "$idle_all" >>"$state.tmp"
    pct=0
    if [[ -n ${prev[$cpu]:-} ]]; then
      read -r prev_tot prev_idle <<<"${prev[$cpu]}"
      local dt=$((tot - prev_tot)) di=$((idle_all - prev_idle))
      ((dt > 0)) && pct=$(((100 * (dt - di) + dt / 2) / dt))
    fi
    ((pct > 100)) && pct=100
    ((pct < 0)) && pct=0
    cores+=("${cpu#cpu}:$pct")
  done </proc/stat
  mv "$state.tmp" "$state"

  # Cluster label + current MHz per thread. cpuinfo_max_freq separates
  # P-cores (4.8GHz) / E-cores (3.8) / LP-E (2.1) for free.
  for entry in "${cores[@]}"; do
    i=${entry%%:*}
    pct=${entry##*:}
    local base="/sys/devices/system/cpu/cpu$i/cpufreq"
    local mhz=0 maxk=0 cluster="CPU"
    [[ -r $base/scaling_cur_freq ]] && mhz=$(($(<"$base/scaling_cur_freq") / 1000))
    [[ -r $base/cpuinfo_max_freq ]] && maxk=$(<"$base/cpuinfo_max_freq")
    if ((maxk >= 4000000)); then cluster="P"
    elif ((maxk >= 3000000)); then cluster="E"
    elif ((maxk > 0)); then cluster="LP"; fi
    out+=("{\"id\":$i,\"pct\":$pct,\"mhz\":$mhz,\"cluster\":\"$cluster\"}")
  done

  read -r l1 l5 l15 procs _ </proc/loadavg

  # Top processes by CPU delta (ps %CPU is lifetime-average, not live).
  # Normalized by the real elapsed time between samples, since the panel's
  # tick and this script's invocation rate need not agree.
  local pstate="$state_dir/x1-bar-detail-proc.prev"
  local now_up prev_up elapsed
  read -r now_up _ </proc/uptime
  prev_up=$(cat "$pstate.time" 2>/dev/null || echo 0)
  elapsed=$(awk -v a="$now_up" -v b="$prev_up" 'BEGIN{d=a-b; if (d <= 0 || d > 30) d = 0; printf "%.3f", d}')
  printf '%s\n' "$now_up" >"$pstate.time"

  local top
  top=$(
    {
      [[ -r $pstate ]] && cat "$pstate"
      echo "---"
      for p in /proc/[0-9]*; do
        [[ -r $p/stat ]] || continue
        # shellcheck disable=SC2162
        read -a f <"$p/stat" 2>/dev/null || continue
        name=${f[1]#(}
        name=${name%)}
        printf '%s %s %s\n' "${p#/proc/}" "$((${f[13]:-0} + ${f[14]:-0}))" "$name"
      done | tee "$pstate.tmp"
    } | awk -v n=5 '
      /^---$/ { cur = 1; next }
      !cur { prev[$1] = $2; next }
      { d = $2 - (($1 in prev) ? prev[$1] : $2); if (d > 0) agg[$3] += d }
      END {
        for (k in agg) printf "%d\t%s\n", agg[k], k
      }' | sort -rn | head -5
  )
  mv "$pstate.tmp" "$pstate" 2>/dev/null || true

  # Percentages computed in the same awk pass that ranks them; e <= 0 means
  # no usable window yet (first run / stale state) -> report -1, not a bogus
  # lifetime-scale number.
  local ticks topjson="" first=1 pct name
  ticks=$(getconf CLK_TCK)
  while IFS=$'\t' read -r pct name; do
    [[ -n ${name:-} ]] || continue
    ((first)) || topjson+=","
    first=0
    topjson+="{\"name\":\"$(jstr "$name")\",\"pct\":$pct}"
  done < <(awk -v t="$ticks" -v e="$elapsed" -F'\t' \
    'BEGIN{ OFS="\t" } { print (e <= 0 ? -1 : int(100 * $1 / (t * e))), $2 }' <<<"$top")

  printf '{"cores":[%s],"load":"%s · %s · %s","procs":"%s","top":[%s]}\n' \
    "$(
      IFS=,
      echo "${out[*]}"
    )" "$l1" "$l5" "$l15" "$procs" "$topjson"
}

detail_mem() {
  # zram-backed swap compresses RAM rather than hitting disk.
  local zram=false
  [[ -e /sys/block/zram0 ]] && zram=true

  # One awk pass over /proc/meminfo emits every GB figure at once; a helper
  # per field would fork a dozen times per tick.
  local total used avail free buffers cached shmem dirty pct swapu swapt swappct
  read -r total used avail free buffers cached shmem dirty pct swapu swapt swappct < <(
    awk '{gsub(":",""); v[$1] = $2} END {
      used = v["MemTotal"] - v["MemAvailable"]
      swapu = v["SwapTotal"] - v["SwapFree"]
      printf "%.1f %.1f %.1f %.1f %.1f %.1f %.1f %.1f %d %.1f %.1f %d",
        v["MemTotal"]/1048576, used/1048576, v["MemAvailable"]/1048576,
        v["MemFree"]/1048576, v["Buffers"]/1048576,
        (v["Cached"] + v["SReclaimable"])/1048576, v["Shmem"]/1048576,
        v["Dirty"]/1048576, 100 * used / v["MemTotal"],
        swapu/1048576, v["SwapTotal"]/1048576,
        (v["SwapTotal"] > 0 ? 100 * swapu / v["SwapTotal"] : 0)
    }' /proc/meminfo
  )

  # Top by RSS, aggregated per command name (chromium/electron fragment).
  local topjson="" first=1 rss name
  while IFS=$'\t' read -r rss name; do
    [[ -n ${name:-} ]] || continue
    ((first)) || topjson+=","
    first=0
    topjson+="{\"name\":\"$(jstr "$name")\",\"gb\":$rss}"
  done < <(ps -eo comm,rss --no-headers |
    awk '{agg[$1] += $2} END {for (k in agg) printf "%.1f\t%s\n", agg[k]/1048576, k}' |
    sort -rn | head -5)

  printf '{"total":%s,"used":%s,"available":%s,"free":%s,"buffers":%s,"cached":%s,"shmem":%s,"dirty":%s,"pct":%d,"swap":{"used":%s,"total":%s,"pct":%d,"zram":%s},"top":[%s]}\n' \
    "$total" "$used" "$avail" "$free" "$buffers" "$cached" "$shmem" "$dirty" "$pct" \
    "$swapu" "$swapt" "$swappct" "$zram" "$topjson"
}

detail_temp() {
  local cores="" others="" fans="" first_o=1 first_f=1
  local -a core_rows=()
  local h name lbl val crit

  for h in /sys/class/hwmon/hwmon*; do
    [[ -r $h/name ]] || continue
    name=$(<"$h/name")
    for input in "$h"/temp*_input; do
      [[ -r $input ]] || continue
      # read builtin, not cat: this loop runs over ~40 sysfs files per tick.
      # Reads can still fail (ENXIO on absent ThinkPad sensors), hence the guard.
      read -r val <"$input" 2>/dev/null || continue
      [[ -n $val && $val != 0 ]] || continue
      lbl=""
      [[ -r ${input%_input}_label ]] && read -r lbl <"${input%_input}_label" 2>/dev/null
      crit=110000
      [[ -r ${input%_input}_crit ]] && read -r crit <"${input%_input}_crit" 2>/dev/null
      local c=$(((val + 500) / 1000)) cc=$(((crit + 500) / 1000))
      case "$name" in
      coretemp)
        [[ $lbl == Core* ]] || continue
        # Collected unsorted (sysfs globs lexically, and hybrid CPUs have
        # sparse indices); ordered by core number after the loop.
        core_rows+=("${lbl##* }|{\"label\":\"$(jstr "$lbl")\",\"c\":$c,\"crit\":$cc}")
        ;;
      nvme)
        [[ $lbl == Composite ]] || continue
        ((first_o)) || others+=","
        first_o=0
        others+="{\"label\":\"NVMe\",\"c\":$c,\"crit\":$cc}"
        ;;
      iwlwifi*)
        ((first_o)) || others+=","
        first_o=0
        others+="{\"label\":\"Wi-Fi\",\"c\":$c,\"crit\":$cc}"
        ;;
      thinkpad)
        [[ $lbl == CPU ]] || continue
        ((first_o)) || others+=","
        first_o=0
        others+="{\"label\":\"Chassis (EC)\",\"c\":$c,\"crit\":$cc}"
        ;;
      esac
    done
    # ThinkPad dual fans.
    if [[ $name == thinkpad ]]; then
      for f in "$h"/fan[0-9]_input; do
        [[ -r $f ]] || continue
        read -r val <"$f" 2>/dev/null || continue
        ((first_f)) || fans+=","
        first_f=0
        local fname=${f##*/}
        fans+="{\"label\":\"Fan ${fname:3:1}\",\"rpm\":$val}"
      done
    fi
  done

  # Skin sensors expose how warm the laptop body actually is.
  local z ztype
  for z in /sys/class/thermal/thermal_zone*; do
    [[ -r $z/type && -r $z/temp ]] || continue
    ztype=$(<"$z/type")
    [[ $ztype == SEN[0-9] ]] || continue
    read -r val <"$z/temp" 2>/dev/null || continue
    ((val > 0)) || continue
    ((first_o)) || others+=","
    first_o=0
    others+="{\"label\":\"Skin $ztype\",\"c\":$(((val + 500) / 1000)),\"crit\":100}"
  done

  local first_c=1 row
  while IFS= read -r row; do
    ((first_c)) || cores+=","
    first_c=0
    cores+="${row#*|}"
  done < <(printf '%s\n' "${core_rows[@]}" | sort -t'|' -k1,1n)

  local level=""
  [[ -r /proc/acpi/ibm/fan ]] && level=$(awk '/^level:/{print $2; exit}' /proc/acpi/ibm/fan 2>/dev/null || true)

  printf '{"cores":[%s],"others":[%s],"fans":[%s],"fanLevel":"%s"}\n' \
    "$cores" "$others" "$fans" "$level"
}

detail_disk() {
  local fsjson="" first=1
  while read -r fs type blocks used avail pct mount; do
    ((first)) || fsjson+=","
    first=0
    fsjson+="{\"mount\":\"$(jstr "$mount")\",\"fstype\":\"$(jstr "$type")\",\"used\":${used%G},\"total\":${blocks%G},\"pct\":${pct%\%}}"
  done < <(df -P -T -BG -x tmpfs -x devtmpfs -x efivarfs -x overlay 2>/dev/null |
    awk 'NR > 1 && !seen[$1]++')

  local model=""
  [[ -r /sys/class/nvme/nvme0/model ]] && model=$(<"/sys/class/nvme/nvme0/model")
  model=${model%"${model##*[![:space:]]}"}

  printf '{"filesystems":[%s],"nvme":"%s"}\n' "$fsjson" "$(jstr "$model")"
}

case "$section" in
cpu) detail_cpu ;;
mem) detail_mem ;;
temp) detail_temp ;;
disk) detail_disk ;;
*)
  echo "usage: x1-bar-detail <cpu|mem|temp|disk>" >&2
  exit 1
  ;;
esac
