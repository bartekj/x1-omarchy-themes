#!/usr/bin/env bash
# Cycle through the X1 theme family.
set -euo pipefail

themes=(x1 x1-stealth x1-redline x1-graphite x1-ember x1-azure x1-moss)
f="$HOME/.local/state/omarchy/current/theme.name"
current="x1"
[[ -r $f ]] && current="$(<"$f")"

next="${themes[0]}"
for i in "${!themes[@]}"; do
  [[ ${themes[$i]} == "$current" ]] && next="${themes[$(((i + 1) % ${#themes[@]}))]}" && break
done

exec omarchy-theme-set "$next"
