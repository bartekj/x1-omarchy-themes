#!/usr/bin/env bash
set -euo pipefail

# Nightlight is ON iff hyprsunset is reachable AND reports a night temp.
# Omarchy convention: ON=4000K, OFF=6000K; identity mode reports 6500K;
# daemon not running => query fails => treated as off.
# NOTE: hyprctl prints connection errors to STDOUT (exit 3), so only a bare
# number on exit 0 counts as a real temperature.
temperature="$(hyprctl hyprsunset temperature 2>/dev/null)" || temperature=""
temperature="${temperature//[^0-9]/}"
[[ "$temperature" =~ ^[0-9]{3,5}$ ]] || temperature=""

if [[ -n "$temperature" && "$temperature" -lt 5000 ]]; then
  jq -nc --arg tooltip "Night light: ${temperature}K
Click: toggle" '{text:"󰖔", tooltip:$tooltip, class:"enabled"}'
else
  jq -nc '{text:"󰖨", tooltip:"Night light: off\nClick: toggle", class:"disabled"}'
fi
