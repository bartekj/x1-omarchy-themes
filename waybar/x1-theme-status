#!/usr/bin/env bash
set -euo pipefail

theme_file="$HOME/.config/omarchy/current/theme.name"
theme="x1"
[[ -f "$theme_file" ]] && theme="$(<"$theme_file")"

case "$theme" in
  x1)
    label="Carbon"
    class="carbon"
    ;;
  x1-stealth)
    label="Stealth"
    class="stealth"
    ;;
  x1-redline)
    label="Redline"
    class="redline"
    ;;
  x1-graphite)
    label="Graphite"
    class="graphite"
    ;;
  *)
    label="$(printf '%s' "$theme" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g')"
    class="external"
    ;;
esac

tooltip="X1 theme: $label
Left click: choose variant
Right click: next variant

Carbon
Stealth
Redline
Graphite"

jq -nc --arg text "$label" --arg tooltip "$tooltip" --arg class "$class" \
  '{text:$text, tooltip:$tooltip, class:$class}'
