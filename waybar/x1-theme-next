#!/usr/bin/env bash
set -euo pipefail

themes=(
  "x1"
  "x1-stealth"
  "x1-redline"
  "x1-graphite"
)

theme_file="$HOME/.config/omarchy/current/theme.name"
current="x1"
[[ -f "$theme_file" ]] && current="$(<"$theme_file")"

next="${themes[0]}"
for i in "${!themes[@]}"; do
  if [[ "${themes[$i]}" == "$current" ]]; then
    next="${themes[$(((i + 1) % ${#themes[@]}))]}"
    break
  fi
done

exec omarchy theme set "$next"
